{
  "name": "api-gen-package",
  "version": "2.0.0",
  "description": "Generate a TypeScript API client, React Query hooks and shadcn/ui CRUD dashboards from OpenAPI 3 documents.",
  "main": "index.js",
  "bin": {
    "generate-api": "bin/generate-api.js",
    "api-gen": "bin/generate-api.js"
  },
  "files": [
    "bin",
    "generators",
    "lib",
    "utils",
    "index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "generate": "node bin/generate-api.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "swagger",
    "openapi",
    "typescript",
    "api-generator",
    "react-query",
    "shadcn",
    "dashboard"
  ],
  "author": "FN MALIC",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "commander": "^15.0.0",
    "prettier": "^3.9.9"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "^19.3.0",
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
