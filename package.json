{
  "name": "api-gen-package",
  "version": "2.2.0",
  "description": "Generate a TypeScript API client, React Query hooks and shadcn/ui CRUD dashboards from OpenAPI 3 documents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "generate-api": "bin/generate-api.js",
    "api-gen": "bin/generate-api.js"
  },
  "files": [
    "bin",
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node src/cli.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "swagger",
    "openapi",
    "typescript",
    "api-generator",
    "react-query",
    "shadcn",
    "dashboard"
  ],
  "author": "FN MALIC",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "prettier": "^3.9.9",
    "swagger2openapi": "^7.0.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "axios": "^1.20.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
